<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BulletSharp.SoftBody.Double</AssemblyName>
    <RootNamespace>BulletSharp.SoftBody</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);BT_USE_DOUBLE_PRECISION</DefineConstants>
  </PropertyGroup>

  <!-- NuGet package metadata (double precision / double) -->
  <PropertyGroup>
    <PackageId>BulletSharp.PureCSharp.SoftBody.Double</PackageId>
    <Version>0.1.0</Version>
    <Authors>bullet-sharp contributors</Authors>
    <Description>Classic btSoftBody module (ropes, cloth, pressure/tetrahedral soft bodies, SparseSdf, soft-rigid coupling) for BulletSharp.PureCSharp.Double, double-precision (double) build.</Description>
    <PackageTags>bullet;physics;bulletsharp;softbody;cloth;physics-engine;double-precision;double</PackageTags>
    <PackageLicenseExpression>Zlib</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/sselecirPyM/bullet-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sselecirPyM/bullet-sharp</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\BulletSharp.SoftBody\**\*.cs"
             Exclude="..\BulletSharp.SoftBody\bin\**;..\BulletSharp.SoftBody\obj\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BulletSharp.Double\BulletSharp.Double.csproj" />
  </ItemGroup>

</Project>
