<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BulletSharp.Double</AssemblyName>
    <RootNamespace>BulletSharp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);BT_USE_DOUBLE_PRECISION</DefineConstants>
  </PropertyGroup>

  <!-- NuGet package metadata (double precision / double) -->
  <PropertyGroup>
    <PackageId>BulletSharp.PureCSharp.Double</PackageId>
    <Version>0.1.0</Version>
    <Authors>bullet-sharp contributors</Authors>
    <Description>Pure C# port of the Bullet Physics engine, double-precision (double) build (rigid body dynamics, collision detection, constraints). API-compatible with BulletSharp; no native dependencies.</Description>
    <PackageTags>bullet;physics;bulletsharp;collision;physics-engine;double-precision;double</PackageTags>
    <PackageLicenseExpression>Zlib</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/sselecirPyM/bullet-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sselecirPyM/bullet-sharp</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\BulletSharp\**\*.cs"
             Exclude="..\BulletSharp\bin\**;..\BulletSharp\obj\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BulletSharp.SoftBody.Double" />
  </ItemGroup>

</Project>
