<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <Precision Condition="'$(Precision)' == ''">float</Precision>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Precision)' == 'double'">
    <DefineConstants>$(DefineConstants);BT_USE_DOUBLE_PRECISION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(Precision)' != 'double'">
    <ProjectReference Include="..\..\src\BulletSharp\BulletSharp.csproj" />
    <ProjectReference Include="..\..\src\BulletSharp.SoftBody\BulletSharp.SoftBody.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Precision)' == 'double'">
    <ProjectReference Include="..\..\src\BulletSharp.Double\BulletSharp.Double.csproj" />
    <ProjectReference Include="..\..\src\BulletSharp.SoftBody.Double\BulletSharp.SoftBody.Double.csproj" />
  </ItemGroup>

</Project>
